{
  "id": "com.msdsh.sound-pad.premiere",
  "name": "Sound Pad for Premiere Pro",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "manifestVersion": 5,
  "requiredPermissions": {
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "id": "sound-pad-panel",
      "type": "panel",
      "minimumSize": {
        "width": 300,
        "height": 360
      },
      "preferredDockedSize": {
        "width": 380,
        "height": 680
      },
      "preferredFloatingSize": {
        "width": 440,
        "height": 720
      },
      "label": {
        "default": "Sound Pad"
      }
    }
  ]
}
